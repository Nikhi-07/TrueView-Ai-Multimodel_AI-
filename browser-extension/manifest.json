{
  "manifest_version": 3,
  "name": "TrueView AI Monitor",
  "version": "1.0.0",
  "description": "Real-time AI behaviour monitoring & secure proctoring layer for Google Meet, Teams, and browser applications.",
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "action": {
    "default_popup": "src/popup/index.html",
    "default_title": "TrueView AI Monitor",
    "default_icon": {
      "16": "icons/icon16.png",
      "48": "icons/icon48.png"
    }
  },
  "background": {
    "service_worker": "src/background/service-worker.ts",
    "type": "module"
  },
  "side_panel": {
    "default_path": "src/sidepanel/index.html"
  },
  "content_scripts": [
    {
      "matches": [
        "https://meet.google.com/*",
        "https://teams.microsoft.com/*",
        "https://teams.live.com/*"
      ],
      "js": ["src/content/content-script.ts"],
      "run_at": "document_end"
    }
  ],
  "permissions": [
    "storage",
    "activeTab",
    "sidePanel",
    "scripting",
    "notifications"
  ],
  "host_permissions": [
    "https://meet.google.com/*",
    "https://teams.microsoft.com/*",
    "http://localhost:5000/*",
    "http://localhost:5173/*",
    "http://localhost:8000/*",
    "http://127.0.0.1:5000/*",
    "http://127.0.0.1:5173/*",
    "http://127.0.0.1:8000/*"
  ],
  "optional_host_permissions": [
    "https://*/*",
    "http://*/*"
  ],
  "web_accessible_resources": [
    {
      "resources": ["assets/*", "content/*", "icons/*"],
      "matches": ["<all_urls>"]
    }
  ]
}
