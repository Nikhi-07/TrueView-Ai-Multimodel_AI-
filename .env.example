# =========================================================================
# TrueView AI – Environment Variables (example)
# =========================================================================
# Copy this file to `.env` and fill in real values. NEVER commit `.env`.
# All values below are placeholders – do not put real secrets in this file.
#
# Loaded by: server/.env (dotenv) and read directly by the client (VITE_*)
# and the AI service (os.environ).

# ─────────────────────────────────────────────────────────────────────────
# Server (Express + Socket.IO, default port 5000)
# ─────────────────────────────────────────────────────────────────────────
# Node environment: development | test | production
NODE_ENV=development

# HTTP port for the backend API + Socket.IO server
PORT=5000

# MongoDB connection string (local or Atlas). No credentials are hardcoded.
MONGO_URI=mongodb://localhost:27017/trueview

# JWT signing secret – MUST be a long random string in production.
# Generate with: openssl rand -base64 48
JWT_SECRET=change-me-to-a-long-random-secret

# Comma-separated list of allowed browser origins (beyond CLIENT_URL and
# localhost dev origins). Example: https://proctor.example.com
CORS_ORIGINS=

# URL of the browser client (used for CORS allowlisting)
CLIENT_URL=http://localhost:5173

# URL of the FastAPI AI service
AI_SERVICE_URL=http://127.0.0.1:8000

# Biometric match thresholds (0..1)
FACE_MATCH_THRESHOLD=0.48
VOICE_MATCH_THRESHOLD=0.75

# Timer warning thresholds in minutes remaining (comma separated, ascending)
TIMER_WARNING_MINUTES=10,5,1

# Seeded demo admin credentials (used only by `npm run seed`)
ADMIN_EMAIL=admin@trueview.ai
ADMIN_PASSWORD=password123

# ─────────────────────────────────────────────────────────────────────────
# Client (Vite – variables prefixed with VITE_ are exposed to the browser)
# ─────────────────────────────────────────────────────────────────────────
# Base URL of the backend API (falls back to the Vite dev proxy in dev)
VITE_API_URL=

# Explicit Socket.IO server URL (falls back to same-origin detection in dev)
VITE_SOCKET_URL=

# ─────────────────────────────────────────────────────────────────────────
# AI Service (FastAPI, default port 8000)
# ─────────────────────────────────────────────────────────────────────────
# Host/port the FastAPI server binds to
AI_HOST=0.0.0.0
AI_PORT=8000
# Use --reload style auto-reload during development only
AI_RELOAD=false

# Comma-separated allowed CORS origins for the AI service
# (default "*" is acceptable for local development; restrict in production)
AI_CORS_ORIGINS=*

# Whisper (faster-whisper) transcription settings
WHISPER_MODEL_SIZE=base
WHISPER_DEVICE=auto
WHISPER_COMPUTE_TYPE=int8
